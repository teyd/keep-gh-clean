# Build-time config for keep-gh-clean. There are no secrets here: each visitor
# pastes their own GitHub token into the browser at runtime, so it never touches
# the build or this file.
# @defaultSensitive=false @defaultRequired=infer
# @generateTsTypes(path=./src/env.d.ts)
# ---

# Path the site is served from. CI sets this from actions/configure-pages
# (e.g. "/keep-gh-clean/"); "/" works for local dev and custom domains.
BASE_PATH=/

# Source code link shown in the footer, so visitors can audit what they paste a token into.
# @type=url
SOURCE_URL=https://github.com/teyd/keep-gh-clean
